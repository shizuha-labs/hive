#!/bin/bash
# Shizuha local CI gate (operator 2026-07-12): pushing to main/master is
# IMPOSSIBLE unless the repo's CI-equivalent test suite passes locally.
# Two ring-wedges in one day were caused by red-on-main pushes; the doctrine
# (verify-before-push) is now mechanical, not optional.
#
# Bypass ONLY for a genuine emergency (logged loudly):
#   SHIZUHA_PUSH_UNSAFE=1 git push ...
set -u
gate_needed=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master) gate_needed=1 ;;
  esac
done
[ "$gate_needed" = 1 ] || exit 0

if [ "${SHIZUHA_PUSH_UNSAFE:-}" = "1" ]; then
  echo "!!! SHIZUHA_PUSH_UNSAFE=1 — CI gate BYPASSED for a primary-branch push. This is audited; justify it in the commit/task." >&2
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)

# The gate runs against the WORKING TREE, so "what was tested" and "what ships"
# are only the same thing when the tree matches the commit being pushed.
# 2026-08-04: a test fix was `git add`ed but never committed. The gate copied
# the worktree, saw the fix, went green — and pushed a commit WITHOUT it. main
# carried a red commit until an unrelated session happened to sweep the staged
# change into its own commit. The hook already reads the pushed SHA and then
# ignored it; refuse the push instead when they disagree.
dirty_tracked=$(git status --porcelain --untracked-files=no 2>/dev/null)
if [ -n "$dirty_tracked" ]; then
  echo "" >&2
  echo "XXX PUSH BLOCKED: working tree differs from the commit being pushed." >&2
  echo "    The gate tests the WORKING TREE. Pushing now would ship a commit" >&2
  echo "    that was never the thing tested (and on this shared checkout the" >&2
  echo "    diff may not even be yours). Commit or stash first:" >&2
  echo "" >&2
  echo "$dirty_tracked" | sed 's/^/      /' >&2
  echo "" >&2
  echo "    Emergency bypass (audited): SHIZUHA_PUSH_UNSAFE=1 git push" >&2
  exit 1
fi

gate="$repo_root/.ci-local-gate.sh"
if [ ! -x "$gate" ]; then
  echo "pre-push: no .ci-local-gate.sh in this repo — allowing push (add one to gate it)." >&2
  exit 0
fi
echo ">>> local CI gate: running $(basename "$gate") before primary-branch push..." >&2
if ! "$gate"; then
  echo "" >&2
  echo "XXX PUSH BLOCKED: local CI gate FAILED. Fix the tests (or the code) first." >&2
  echo "    A red main wedges the deploy ring for every later commit." >&2
  echo "    Emergency bypass (audited): SHIZUHA_PUSH_UNSAFE=1 git push" >&2
  exit 1
fi
echo ">>> local CI gate PASSED — pushing." >&2
exit 0
